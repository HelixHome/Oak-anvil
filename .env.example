# Shopify Storefront API — fill in once the Shopify store + headless app exist
# Copy this file to .env.local (never commit .env.local)
# Also add these in Vercel → Project → Settings → Environment Variables

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Leave empty to use local mock data instead of live Shopify
